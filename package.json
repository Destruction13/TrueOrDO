{
  "name": "true-or-do",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev --prefix server\" \"npm:dev:delayed --prefix client\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:reset": "npm --prefix server run db:reset"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
