    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "multer": "^2.0.2",
    "nanoid": "^5.0.3",
    "nodemailer": "^7.0.12",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1"
  }
