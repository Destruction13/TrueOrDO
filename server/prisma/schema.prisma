datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTH MODELS
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?   // Опционально для OAuth пользователей
  emailVerifiedAt DateTime?
  nickname        String?   @unique
  avatarUrl       String?
  bio             String?
  
  // OAuth провайдеры
  discordId       String?   @unique
  googleId        String?   @unique
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  userId    String
  data      String   // JSON session data
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// GAME MODELS
// ═══════════════════════════════════════════════════════════════════════════

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  createdAt DateTime @default(now())
  hostId    String
  settings  String   @default("{}")

  players   Player[]
  rounds    Round[]
}

model Player {
  id                  String   @id @default(cuid())
  roomId              String
  name                String
  avatarUrl           String?
  visitorId           String?                      // уникальный ID браузера/устройства для бан-листа
  status              String   @default("active") // "active" | "shamed" | "chaos"
  connectionStatus    String   @default("online") // "online" | "disconnected" | "left"
  strikes             Int      @default(0)
  shameTitle          String?                      // язвительная фраза для shamed
  shameClearProgress  Int      @default(0)         // прогресс снятия shamed (0..2)
  chaosClearProgress  Int      @default(0)         // прогресс снятия chaos (0..2)
  truthStreak         Int      @default(0)         // количество Правд подряд (макс 2)
  dareStreak          Int      @default(0)         // количество Действий подряд (макс 2)
  joinedAt            DateTime @default(now())
  lastSeen            DateTime @default(now())

  room           Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  votes          Vote[]
  currentRounds  Round[] @relation("RoundCurrentPlayer")
}

model Round {
  id              String   @id @default(cuid())
  roomId          String
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  currentPlayerId String?  // Игрок, выполняющий задание (targetPlayer)
  turnPlayerId    String?  // Игрок, чей ход (выбирает targetPlayer)
  mode            String?
  timerSeconds    Int
  phase           String   @default("idle")
  taskStatus      String   @default("pending") // pending | accepted | done | refused
  taskAcceptedAt  DateTime?
  result          String?

  room           Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  currentPlayer  Player? @relation("RoundCurrentPlayer", fields: [currentPlayerId], references: [id], onDelete: SetNull)
  spins          Spin[]
  votes          Vote[]
}

model Spin {
  id           String @id @default(cuid())
  roundId      String @unique
  wheel1Result String
  wheel2Result String
  finalText    String

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

model Vote {
  id            String   @id @default(cuid())
  roundId       String
  voterPlayerId String
  vote          String
  createdAt     DateTime @default(now())

  round Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter Player @relation(fields: [voterPlayerId], references: [id], onDelete: Cascade)

  @@unique([roundId, voterPlayerId])
}
